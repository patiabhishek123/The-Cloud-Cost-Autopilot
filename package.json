    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^17.3.1",
    "openai": "^6.27.0",
    "pino": "^10.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
